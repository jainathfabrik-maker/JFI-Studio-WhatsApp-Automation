# ============================================================================
# JFI Studio WhatsApp Automation — environment variable template
#
# Copy this file to `.env` for local runs:  cp .env.example .env
# On Render, set these in the service's "Environment" tab (never in Git).
# This file contains NO real secrets and must never be filled in with any.
# ============================================================================

# --- Runtime ----------------------------------------------------------------
NODE_ENV=production
# Render injects PORT itself; keep this only for local runs.
PORT=3000
LOG_LEVEL=info
TIMEZONE=Asia/Kolkata
# Where packs, run state and the run lock are written.
# On Render with a persistent disk attached, use e.g. /var/data
DATA_DIR=./data

# --- Scheduler --------------------------------------------------------------
# false = no in-process timer (recommended on Render; use a Render Cron Job).
# true  = in-process cron at DAILY_CRON (only for an always-on instance).
ENABLE_INTERNAL_CRON=false
# Alias accepted: DAILY_SCHEDULE
DAILY_CRON="30 8 * * *"

# --- Meta WhatsApp Cloud API ------------------------------------------------
# Graph API version. Check Meta's changelog and raise this deliberately.
# Alias accepted: META_API_VERSION
META_GRAPH_API_VERSION=v26.0

# Permanent access token from a System User in Meta Business settings.
# REQUIRED.
META_ACCESS_TOKEN=

# Meta app secret (App Dashboard > App settings > Basic). Used to verify
# x-hub-signature-256 on every inbound webhook. REQUIRED.
META_APP_SECRET=

# A long random string you invent. Enter the same value in the Meta webhook
# configuration screen. REQUIRED. Must not equal any token above.
META_VERIFY_TOKEN=

# Meta App ID (App settings > Basic). OPTIONAL — the service itself does not
# need it; scripts/setup-meta.js uses it to register the webhook subscription.
# Not the Phone Number ID, not the WABA ID.
META_APP_ID=

# WhatsApp Business Phone Number ID (NOT the phone number, NOT the WABA ID,
# NOT the App ID). Found in App Dashboard > WhatsApp > API Setup. REQUIRED.
WHATSAPP_PHONE_NUMBER_ID=

# WhatsApp Business Account ID. Optional; only used by the diagnostic
# /admin/diagnostics endpoint to confirm it can read the account.
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Recipient in international format, digits only, e.g. 919876543210.
# This must be a DIFFERENT number from the sending business number. REQUIRED.
WHATSAPP_RECIPIENT_NUMBER=

# Optional self-send guard. Set this to the business number that owns
# WHATSAPP_PHONE_NUMBER_ID (digits only). If left blank the app looks it up
# from the Graph API at startup instead.
WHATSAPP_SENDER_NUMBER=

# --- Delivery ---------------------------------------------------------------
# link = send an approved template whose URL button opens the full pack page
#        (recommended; the only reliable way to push outside a 24h window).
# text = send the pack as free-form text; only allowed inside an open
#        24-hour customer service window.
WHATSAPP_DELIVERY_MODE=link

# Approved template name and language code (WhatsApp Manager > Templates).
WHATSAPP_TEMPLATE_NAME=jfi_daily_content_pack
WHATSAPP_TEMPLATE_LANGUAGE=en

# Index of the template's dynamic URL button (0 = first button).
WHATSAPP_TEMPLATE_URL_BUTTON_INDEX=0

# Which pack fields fill the template's body variables {{1}}, {{2}}...
# Comma separated, in order.
# Allowed: dateLabel, pillar, hook, format, concept, publishTimeIST
# Leave at dateLabel for the one-variable template in docs/META-WEBHOOK-SETUP.md
WHATSAPP_TEMPLATE_BODY_FIELDS=dateLabel

# Public HTTPS base URL, no trailing slash. OPTIONAL — leave it blank.
# The app resolves its own URL automatically: on Render from RENDER_EXTERNAL_URL,
# and otherwise from the address of the request that triggers the run. Set this
# only if you serve the app from a custom domain.
PUBLIC_BASE_URL=

# Long random key protecting /admin/* endpoints. Required if you use a
# Render Cron Job or the manual trigger. Must not equal any token above.
ADMIN_TRIGGER_TOKEN=

# --- Content generation -----------------------------------------------------
# auto   = use OpenAI when OPENAI_API_KEY is set, otherwise the built-in
#          static pack bank (no network, no cost).
# openai = require OpenAI; fail loudly if it errors.
# static = always use the built-in pack bank.
CONTENT_SOURCE=auto

# OpenAI API key from an API project (separate from a ChatGPT subscription).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# --- Storage ----------------------------------------------------------------
# file  = local disk under DATA_DIR. Correct for Render, Docker, any VM.
# redis = Upstash Redis over HTTPS. Use this on a serverless host (Vercel,
#         Netlify, Lambda) where there is no persistent disk, otherwise pack
#         links 404 and the run lock and webhook de-dupe reset.
STORAGE_DRIVER=file

# Only needed when STORAGE_DRIVER=redis. From the Upstash console → your
# database → REST API. Use the REST URL/token, not the Redis host and port.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Tuning (safe to leave at defaults) -------------------------------------
META_TIMEOUT_MS=15000
META_MAX_RETRIES=2
OPENAI_TIMEOUT_MS=60000
